{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "studio"
        }
      ],
      "destination": "/studio",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "work"
        }
      ],
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "journal"
        }
      ],
      "destination": "/journal",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "contact"
        }
      ],
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "privacy"
        }
      ],
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "terms"
        }
      ],
      "destination": "/terms",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "services"
        }
      ],
      "destination": "/services",
      "statusCode": 301
    },
    {
      "source": "/work/folionomics",
      "destination": "/work",
      "statusCode": 301
    },
    {
      "source": "/journal/startup-website-cost-in-dubai-what-to-budget-in-2026",
      "destination": "/journal/startup-website-cost-dubai",
      "statusCode": 301
    },
    {
      "source": "/journal/webflow-vs-next.js-for-startups-which-to-pick-in-2026",
